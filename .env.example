# Neon Postgres connection string (https://console.neon.tech -> Connection Details)
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth (https://www.better-auth.com/docs/installation)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
